# ---- Secrets (CRITICAL: never commit) ----
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# ---- Run artifacts ----
runs/*
# ...except the P5 benchmark report, which is a deliverable, not a scratch run.
!runs/benchmark/
runs/benchmark/*
!runs/benchmark/results.json
!runs/benchmark/results.md
!runs/benchmark/failure-analysis.md
!runs/benchmark/RESULTS_SUMMARY.md
# Ablation E (experience store), kept apart from the paper-cited 165-run matrix.
!runs/benchmark/ablation-e/
runs/benchmark/ablation-e/*
!runs/benchmark/ablation-e/results.json
!runs/benchmark/ablation-e/results.md
# Ablation F (promoted rules), likewise kept apart.
!runs/benchmark/ablation-f/
runs/benchmark/ablation-f/*
!runs/benchmark/ablation-f/results.json
!runs/benchmark/ablation-f/results.md
# Live-model runs (DEEPSEEK_API_KEY), kept apart from the deterministic results.
!runs/benchmark/live/
runs/benchmark/live/*
!runs/benchmark/live/*results_live*.json
!runs/benchmark/live/*results_live*.md
*.patch
state.db
*.sqlite
*.sqlite3

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
uv.lock

# ---- Testing / tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
report.json

# ---- Knowledge graph (commit the graph, not its extraction cache) ----
graphify-out/cache/

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store

# ---- Corpus scratch (keep committed corpora; ignore working copies) ----
corpus/**/repo_rw/
corpus/**/*.tmp

# ---- Local LLM provider config (copy of mra.example.toml) ----
mra.toml

# ---- Graded submissions (contain the student SRN; kept local, never public) ----
docs/submissions/
graphify-out/20*/
.hypothesis/
